APP_NAME=MindTrail API
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/v1

DATABASE_URL=postgresql+asyncpg://mindtrail:mindtrail@localhost:5432/mindtrail
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Keep disabled until a provider key is configured.
LLM_PROVIDER=disabled
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Store downloaded NLP model artifacts inside the project-local ignored cache.
HF_HOME=.cache/huggingface
